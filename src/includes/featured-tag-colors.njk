{# Featured tag colours, generated from globals/featuredTags.json so they apply
   wherever a featured tag shows up, not just in the featured tags list.
   The accent tints the background and border, text is the label colour. #}
<style>
{%- for tag in featuredTags %}
  .tag.{{ tag.name }} {
    background: color-mix(in srgb, {{ tag.dark.accent }} 8%, transparent);
    border-color: color-mix(in srgb, {{ tag.dark.accent }} 35%, transparent);
    color: {{ tag.dark.text }};
  }
  [data-theme='reading'] .tag.{{ tag.name }},
  [data-theme='beach'] .tag.{{ tag.name }} {
    background: color-mix(in srgb, {{ tag.light.accent }} 8%, transparent);
    border-color: color-mix(in srgb, {{ tag.light.accent }} 40%, transparent);
    color: {{ tag.light.text }};
  }
{%- endfor %}
</style>
